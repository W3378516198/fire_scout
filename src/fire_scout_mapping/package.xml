<?xml version="1.0"?>

<package format="3">

  <name>fire_scout_mapping</name>

  <version>0.0.3</version>

  <description>
    Radar mapping package for Fire Scout.
  </description>

  <maintainer email="wei@todo.todo">
    wei
  </maintainer>

  <license>Apache-2.0</license>

  <buildtool_depend>
    ament_cmake
  </buildtool_depend>

  <depend>
    rclcpp
  </depend>

  <depend>
    sensor_msgs
  </depend>

  <depend>
    tf2
  </depend>

  <depend>
    tf2_ros
  </depend>

  <depend>
    tf2_sensor_msgs
  </depend>

  <!-- Optional planning_map.launch.py shares the navigation evidence mapper. -->
  <exec_depend>fire_scout_planning_safe</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>

    <build_type>
      ament_cmake
    </build_type>

  </export>

</package>
