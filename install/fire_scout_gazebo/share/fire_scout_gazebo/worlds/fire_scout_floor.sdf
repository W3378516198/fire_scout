        <!-- East service exit is offset south to avoid a perfectly symmetric map. -->
        <collision name="east_wall_low_collision"><pose>12 -9.8 4 0 0 0</pose><geometry><box><size>0.35 4.4 8</size></box></geometry></collision>
        <visual name="east_wall_low_visual"><pose>12 -9.8 4 0 0 0</pose><geometry><box><size>0.35 4.4 8</size></box></geometry><material><ambient>0.48 0.57 0.61 1</ambient><diffuse>0.48 0.57 0.61 1</diffuse></material></visual>
        <collision name="east_wall_high_collision"><pose>12 3.8 4 0 0 0</pose><geometry><box><size>0.35 16.4 8</size></box></geometry></collision>
        <visual name="east_wall_high_visual"><pose>12 3.8 4 0 0 0</pose><geometry><box><size>0.35 16.4 8</size></box></geometry><material><ambient>0.48 0.57 0.61 1</ambient><diffuse>0.48 0.57 0.61 1</diffuse></material></visual>
        <collision name="east_entry_header_collision"><pose>12 -6 6.5 0 0 0</pose><geometry><box><size>0.35 3.2 3</size></box></geometry></collision>
        <visual name="east_entry_header_visual"><pose>12 -6 6.5 0 0 0</pose><geometry><box><size>0.35 3.2 3</size></box></geometry><material><ambient>0.36 0.44 0.47 1</ambient><diffuse>0.36 0.44 0.47 1</diffuse></material></visual>

        <!-- North room frontage, with 2 m door gaps at x=-6 and x=6. -->
        <collision name="north_front_w_collision"><pose>-9.5 2.5 4 0 0 0</pose><geometry><box><size>5 0.30 8</size></box></geometry></collision>
        <visual name="north_front_w_visual"><pose>-9.5 2.5 4 0 0 0</pose><geometry><box><size>5 0.30 8</size></box></geometry><material><ambient>0.67 0.71 0.72 1</ambient><diffuse>0.67 0.71 0.72 1</diffuse></material></visual>
        <collision name="north_front_mid_collision"><pose>0 2.5 4 0 0 0</pose><geometry><box><size>10 0.30 8</size></box></geometry></collision>
        <visual name="north_front_mid_visual"><pose>0 2.5 4 0 0 0</pose><geometry><box><size>10 0.30 8</size></box></geometry><material><ambient>0.67 0.71 0.72 1</ambient><diffuse>0.67 0.71 0.72 1</diffuse></material></visual>
        <collision name="north_front_e_collision"><pose>9.5 2.5 4 0 0 0</pose><geometry><box><size>5 0.30 8</size></box></geometry></collision>
        <visual name="north_front_e_visual"><pose>9.5 2.5 4 0 0 0</pose><geometry><box><size>5 0.30 8</size></box></geometry><material><ambient>0.67 0.71 0.72 1</ambient><diffuse>0.67 0.71 0.72 1</diffuse></material></visual>

        <!-- South room frontage mirrors the north side. -->
        <collision name="south_front_w_collision"><pose>-9.5 -2.5 4 0 0 0</pose><geometry><box><size>5 0.30 8</size></box></geometry></collision>
        <visual name="south_front_w_visual"><pose>-9.5 -2.5 4 0 0 0</pose><geometry><box><size>5 0.30 8</size></box></geometry><material><ambient>0.67 0.71 0.72 1</ambient><diffuse>0.67 0.71 0.72 1</diffuse></material></visual>
        <collision name="south_front_mid_collision"><pose>0 -2.5 4 0 0 0</pose><geometry><box><size>10 0.30 8</size></box></geometry></collision>
        <visual name="south_front_mid_visual"><pose>0 -2.5 4 0 0 0</pose><geometry><box><size>10 0.30 8</size></box></geometry><material><ambient>0.67 0.71 0.72 1</ambient><diffuse>0.67 0.71 0.72 1</diffuse></material></visual>
        <collision name="south_front_e_collision"><pose>9.5 -2.5 4 0 0 0</pose><geometry><box><size>5 0.30 8</size></box></geometry></collision>
        <visual name="south_front_e_visual"><pose>9.5 -2.5 4 0 0 0</pose><geometry><box><size>5 0.30 8</size></box></geometry><material><ambient>0.67 0.71 0.72 1</ambient><diffuse>0.67 0.71 0.72 1</diffuse></material></visual>

        <!-- Longitudinal dividers form four main rooms. -->
        <collision name="north_divider_collision"><pose>0 7.25 4 0 0 0</pose><geometry><box><size>0.30 9.5 8</size></box></geometry></collision>
        <visual name="north_divider_visual"><pose>0 7.25 4 0 0 0</pose><geometry><box><size>0.30 9.5 8</size></box></geometry><material><ambient>0.63 0.68 0.69 1</ambient><diffuse>0.63 0.68 0.69 1</diffuse></material></visual>
        <collision name="south_divider_collision"><pose>0 -7.25 4 0 0 0</pose><geometry><box><size>0.30 9.5 8</size></box></geometry></collision>
        <visual name="south_divider_visual"><pose>0 -7.25 4 0 0 0</pose><geometry><box><size>0.30 9.5 8</size></box></geometry><material><ambient>0.63 0.68 0.69 1</ambient><diffuse>0.63 0.68 0.69 1</diffuse></material></visual>

        <!-- A smaller utility room in the north-east corner. -->
        <collision name="utility_partition_w_collision"><pose>4 7.5 4 0 0 0</pose><geometry><box><size>8 0.30 8</size></box></geometry></collision>
        <visual name="utility_partition_w_visual"><pose>4 7.5 4 0 0 0</pose><geometry><box><size>8 0.30 8</size></box></geometry><material><ambient>0.58 0.63 0.64 1</ambient><diffuse>0.58 0.63 0.64 1</diffuse></material></visual>
        <collision name="utility_partition_e_collision"><pose>10.75 7.5 4 0 0 0</pose><geometry><box><size>2.5 0.30 8</size></box></geometry></collision>
        <visual name="utility_partition_e_visual"><pose>10.75 7.5 4 0 0 0</pose><geometry><box><size>2.5 0.30 8</size></box></geometry><material><ambient>0.58 0.63 0.64 1</ambient><diffuse>0.58 0.63 0.64 1</diffuse></material></visual>
      </link>
    </model>

    <!-- ================================================================ -->
    <!-- TOPPLED STORAGE CABINETS                                          -->
    <!-- Each cabinet is a static collision body lying on its side. Their  -->
    <!-- varied yaw angles create realistic non-axis-aligned local detours. -->
    <!-- ================================================================ -->
    <model name="toppled_cabinet_main_north">
      <static>true</static><pose>-3.8 9.5 0.46 1.5707963 0 0.32</pose>
